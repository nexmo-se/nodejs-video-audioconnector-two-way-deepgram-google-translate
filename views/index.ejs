<!DOCTYPE html>
<html>
  <head>
    <link rel="stylesheet" href="/css/style.css" />
    <!-- <script src="https://static.opentok.com/v2/js/opentok.min.js"></script> -->
    <!-- Using local copy of OpenTok SDK -->
    <script src="/opentok-build-3.js"></script>
    <!-- jQuery for DOM manipulation and AJAX calls -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
  </head>
  <body>
    <!-- ENHANCED USER & LANGUAGE MANAGEMENT (moved to top) -->
    <div id="user-info-container">
      <div>
        <strong>Your Connection ID:</strong>
        <span id="user-id-display">Loading...</span>
      </div>
      <div style="margin-top: 5px">
        <label for="preferred_language">Your Preferred Language:</label>
        <select id="preferred_language">
          <!-- === TIER 1: MOST COMMON LANGUAGES === -->
          <option value="en">English</option>
          <option value="es">Spanish</option>
          <option value="fr">French</option>
          <option value="de">German</option>
          <option value="it">Italian</option>
          <option value="pt">Portuguese</option>
          <option value="ja">Japanese</option>
          <option value="ko">Korean</option>
          <option value="zh">Chinese (Mandarin)</option>
          <option value="ru">Russian</option>
          <option value="hi">Hindi</option>
          <option value="nl">Dutch</option>

          <!-- === TIER 2: EUROPEAN LANGUAGES === -->
          <option value="da">Danish</option>
          <option value="sv">Swedish</option>
          <option value="no">Norwegian</option>
          <option value="pl">Polish</option>
          <option value="fi">Finnish</option>
          <option value="cs">Czech</option>
          <option value="bg">Bulgarian</option>
          <option value="ca">Catalan</option>
          <option value="et">Estonian</option>
          <option value="uk">Ukrainian</option>
          <option value="tr">Turkish</option>

          <!-- === TIER 3: ADDITIONAL SUPPORTED LANGUAGES === -->
          <option value="ta">Tamil</option>

          <!-- === REMOVED: NOT SUPPORTED BY NOVA-2 MODEL ===
          Arabic (ar), Thai (th), Indonesian (id) are not supported by nova-2
          See: https://developers.deepgram.com/docs/models-languages-overview
          -->
        </select>
        <button id="set_language_btn" style="margin-left: 10px">
          Set Language
        </button>
      </div>
      <div style="margin-top: 5px; font-size: 0.9em; color: #666">
        <em
          >Other users will hear your speech translated into their preferred
          language</em
        >
      </div>
    </div>

    <!-- SESSION MANAGEMENT PANEL: Links for joining and Deepgram control (moved below user info) -->
    <div class="title">
      <!-- Shareable link for participants to join the video session -->
      Share this link for people to join<br /><input
        type="text"
        style="margin: 10px; width: calc(100% - 500px)"
        id="link"
        value="Starting Session"
        readonly
      />
      <button onclick="copyLink('link')">Copy Link</button><br /><br />

      <!-- DEEPGRAM CONTROL: Start/Stop real-time translation pipeline -->
      <span>
        <button
          id="deepgram_button"
          style="color: white; padding: 5px; background-color: darkslategrey"
          onclick="toggleDeepgram()"
        >
          Start Deepgram
        </button>
      </span>
    </div>

    <!-- TRANSCRIPTION DISPLAY: Real-time translation results (moved below user info) -->
    <div
      id="transcription"
      style="
        height: 200px;
        overflow-y: auto;
        width: 100%;
        background: #f9f9f9;
        padding: 15px;
        border-radius: 5px;
        border: 1px solid #ddd;
        margin-bottom: 20px;
        font-family: monospace;
        font-size: 14px;
      "
    >
      <div id="deepgram">
        <div><strong>Transcription Log:</strong><br /></div>
      </div>
    </div>

    <!-- VIDEO DISPLAY AREA: Containers for video streams -->
    <div>
      <!-- Remote participants' video streams (smaller size) -->
      <div
        id="subscriber"
        style="width: 320px; height: 240px; display: inline-block; margin: 10px"
      ></div>
      <!-- Local user's video stream -->
      <div id="publisher"></div>
    </div>

    <!-- CLIENT-SIDE VIDEO SESSION MANAGEMENT -->
    <script src="/js/client.js" type="module"></script>
  </body>
</html>
<script>
  /**
   * GLOBAL STATE TRACKING FOR DEEPGRAM TRANSLATION PIPELINE
   *
   * Purpose: UI state management and cleanup coordination for multi-user translation
   *
   * Current Usage (simplified architecture):
   * 1. UI STATE MANAGEMENT: Controls Start/Stop Deepgram button states and prevents
   *    multiple simultaneous Audio Connector creations from same user
   *
   * 2. CLEANUP COORDINATION: Ensures proper cleanup of Audio Connector resources
   *    when user stops translation or leaves the session (beforeunload event)
   *
   * 3. DEBUGGING & LOGGING: Provides state visibility for troubleshooting
   *    translation pipeline issues
   *
   * ARCHITECTURAL NOTE: Audio feedback prevention is now handled by design:
   * - Users ALWAYS subscribe only to their OWN Audio Connector (receive translations)
   * - Users NEVER subscribe to other users' Audio Connectors (prevent feedback)
   * - This removed the need for aggressive deepgram_in_use subscription blocking
   *   that was previously too restrictive
   *
   * Flow:
   * - User clicks "Start Deepgram" → setDeepgramInUse(true) → Create Audio Connector
   * - User clicks "Stop Deepgram" → setDeepgramInUse(false) → Cleanup Audio Connector
   * - Page unload → Check deepgram_in_use → Send cleanup if needed
   */
  var deepgram_in_use = false;
  window.deepgram_in_use = deepgram_in_use; // Make globally accessible for client.js

  function setDeepgramInUse(value) {
    deepgram_in_use = value;
    window.deepgram_in_use = value; // Keep window property in sync for cross-module access
    console.log(`🔄 Deepgram pipeline state changed to: ${value}`);
  }

  // User ID will be set to the publisher's connectionId once video session is established
  var userId = null;
  var publisher = null;
  var session = null;

  /**
   * CLIENT-SIDE LOGGING SYSTEM
   * Captures all console logs and sends them to server for file logging
   * while maintaining console output for debugging
   */
  var clientLogBuffer = [];
  var logToFileEnabled = true;
  var originalConsole = {
    log: console.log,
    error: console.error,
    warn: console.warn,
    info: console.info,
  };

  // Enhanced logging function that logs to both console and file
  function logToConsoleAndFile(level, args) {
    // Always log to console first (maintains existing behavior)
    originalConsole[level].apply(console, args);

    if (logToFileEnabled && userId) {
      // Create log entry with timestamp and level
      const timestamp = new Date().toISOString();
      const message = Array.from(args)
        .map((arg) =>
          typeof arg === "object" ? JSON.stringify(arg, null, 2) : String(arg)
        )
        .join(" ");

      const logEntry = {
        timestamp: timestamp,
        level: level.toUpperCase(),
        userId: userId,
        sessionId: "<%=sessionId%>",
        message: message,
      };

      // Send to server via WebSocket if available
      if (ws && ws.readyState === WebSocket.OPEN) {
        try {
          ws.send(
            JSON.stringify({
              command: "client_log",
              logEntry: logEntry,
            })
          );
        } catch (e) {
          // If WebSocket fails, buffer the log for later
          clientLogBuffer.push(logEntry);
        }
      } else {
        // Buffer logs until WebSocket is ready
        clientLogBuffer.push(logEntry);
      }
    }
  }

  // Override console methods to capture all logs
  console.log = function () {
    logToConsoleAndFile("log", arguments);
  };
  console.error = function () {
    logToConsoleAndFile("error", arguments);
  };
  console.warn = function () {
    logToConsoleAndFile("warn", arguments);
  };
  console.info = function () {
    logToConsoleAndFile("info", arguments);
  };

  // Function to flush buffered logs when WebSocket becomes available
  function flushLogBuffer() {
    if (ws && ws.readyState === WebSocket.OPEN && clientLogBuffer.length > 0) {
      console.log(
        `📁 Flushing ${clientLogBuffer.length} buffered client logs to file`
      );
      clientLogBuffer.forEach((logEntry) => {
        try {
          ws.send(
            JSON.stringify({
              command: "client_log",
              logEntry: logEntry,
            })
          );
        } catch (e) {
          originalConsole.error("Failed to send buffered log:", e);
        }
      });
      clientLogBuffer = [];
    }
  }

  console.log("Waiting for video session to establish connectionId...");

  // Initialize DOM references when page loads
  $(document).ready(function () {
    msg_div = document.getElementById("transcription");

    // User ID will be set once video session connects
    document.getElementById("user-id-display").textContent =
      "Connecting to video session...";
  });

  /**
   * ENHANCED WEBSOCKET CONNECTION SETUP
   * Establishes connection to server for real-time transcription updates
   * and Audio Connector control messages with user identification
   * NOW CALLED AFTER video session establishes connectionId
   */
  var ws = null;

  function initializeWebSocket() {
    if (!userId) {
      console.error("Cannot initialize WebSocket without userId");
      return;
    }

    ws = new WebSocket("<%=websocket_server_uri%>");
    ws.onopen = (event) => {
      // WEB CLIENT WEBSOCKET IDENTIFICATION MESSAGE
      // Purpose: Set WebSocket ID to distinguish this browser client from Audio Connector connections
      // Server processing: Handled in "webSocketID" section of WebSocket message handler
      var msg = {
        command: "webSocketID",
        id: "client_<%=sessionId%>",
        userId: userId, // Now using Vonage connectionId as user ID
        sessionId: "<%=sessionId%>",
      };
      ws.send(JSON.stringify(msg));
      console.log("WebSocket connected with connectionId as userId:", userId);

      // Flush any buffered client logs to file
      setTimeout(flushLogBuffer, 100); // Small delay to ensure server is ready

      // Test client logging system
      setTimeout(() => {
        console.log("📁 Client logging system initialized and working!");
        console.info(
          "Client logs will be saved to server-side client log file"
        );
      }, 200);
    };

    // Set up message handler
    ws.onmessage = handleWebSocketMessage;

    // Set up error handler
    ws.onerror = function (error) {
      console.error("WebSocket error:", error);
    };

    // Set up close handler
    ws.onclose = function (event) {
      console.log("WebSocket closed:", event.code, event.reason);
    };
  }

  /**
   * VIDEO SESSION INITIALIZATION
   * Sets up the Vonage Video session and populates shareable links
   * ENHANCED: Extracts connectionId for use as userId
   */
  $(async function () {
    // Initialize video session using parameters from server
    startSession("<%=sessionId%>", "<%=token%>", "<%=appId%>").then(function (
      result
    ) {
      // Generate shareable join link for participants
      $("#link").val(
        window.location.protocol +
          "//" +
          window.location.hostname +
          "/<%=sessionId%>/join"
      );
      // Generate token creation link for additional participants
      $("#token").val(
        window.location.protocol +
          "//" +
          window.location.hostname +
          "/<%=sessionId%>/token"
      );

      // ENHANCED: Extract connectionId from the video session
      // The startSession function should return the session and publisher objects
      // We'll need to modify this to get the connectionId
      if (window.currentSession && window.currentPublisher) {
        session = window.currentSession;
        publisher = window.currentPublisher;

        // Use the publisher's connection ID as our user ID
        userId = session.connection.connectionId;
        console.log("Using connectionId as userId:", userId);

        // Update the UI to show the connectionId
        document.getElementById("user-id-display").textContent = userId;

        // Now that we have a userId, we can establish WebSocket connection
        initializeWebSocket();
      } else {
        console.error(
          "Could not get session/publisher objects from startSession"
        );
      }
    });
  });

  /**
   * UTILITY: Copy text to clipboard
   * Used for sharing session links and token generation URLs
   */
  function copyLink(id) {
    var copyText = document.getElementById(id);
    copyText.select();
    copyText.setSelectionRange(0, 99999);
    document.execCommand("copy");
  }

  /**
   * ENHANCED DEEPGRAM TRANSLATION CONTROL
   * Toggles the real-time translation pipeline on/off using per-user Audio Connectors
   *
   * ON: Starts Per-User Audio Connector → STT → Translation → TTS pipeline
   * OFF: Stops user's Audio Connector and cleans up resources
   */
  async function toggleDeepgram() {
    var button = $("#deepgram_button");

    // Check if we have a userId (connectionId) before proceeding
    if (!userId) {
      alert("Please wait for video session to connect first");
      return;
    }

    // ===== START TRANSLATION PIPELINE =====
    if (deepgram_in_use == false) {
      // Update UI to show startup in progress
      button.text("Starting Deepgram");
      button.css("background-color", "Orange");

      // CRITICAL: Set translation state BEFORE starting Audio Connector
      // This prevents other users from subscribing to our Audio Connector
      setDeepgramInUse(true);
      console.log(
        "🔒 Pre-emptively set deepgram_in_use=true to prevent feedback loops"
      );

      // CRITICAL FIX: Unsubscribe from any existing Audio Connector subscriptions
      // When user starts their own translation, they should not receive others' translations
      if (window.currentSession && window.currentSession.getSubscribers) {
        const existingSubscribers = window.currentSession.getSubscribers();
        existingSubscribers.forEach((subscriber) => {
          const stream = subscriber.stream;
          // Check if this is an Audio Connector stream (audio-only, no video)
          if (stream && stream.hasAudio && !stream.hasVideo) {
            console.log(
              "🔄 CLEANUP: Unsubscribing from existing Audio Connector before starting own translation",
              {
                streamId: stream.streamId,
                streamName: stream.name,
                connectionId: stream.connection?.connectionId,
              }
            );
            window.currentSession.unsubscribe(subscriber);
          }
        });
      }

      // Small delay to ensure global state propagates before Audio Connector creation
      // This helps prevent race conditions where other users see the streamCreated
      // event before our deepgram_in_use state is properly set
      await new Promise((resolve) => setTimeout(resolve, 50)); // Call per-user endpoint to start Audio Connector
      // NOW: Uses connectionId as userId for individual user processing
      // This triggers: Per-user Audio Connector creation → WebSocket connection → STT setup
      $.ajax({
        method: "GET",
        url: "/<%=sessionId%>/audioconnect/" + userId,
      })
        .done(function (msg) {
          // Translation pipeline successfully started
          // setDeepgramInUse(true); // Already set above to prevent timing issues
          console.log(
            "Per-user Audio Connector started for connectionId:",
            userId,
            msg
          );
          button.text("Stop Deepgram");
          button.css("background-color", "darkgreen");

          // Display user info
          $("#deepgram").html(
            $("#deepgram").html() +
              "<div><strong>Connection " +
              userId +
              " joined translation pipeline</strong></div>"
          );
        })
        .fail(function (xhr, status, error) {
          // Audio Connector startup failed - reset state
          console.error("Per-user Audio Connector startup failed:", error);
          setDeepgramInUse(false); // Reset on failure
          alert("Deepgram startup failed: " + error);
          button.text("Start Deepgram");
          button.css("background-color", "darkslategrey");
        });

      // ===== STOP TRANSLATION PIPELINE =====
    } else {
      // ENHANCED CLEANUP REQUEST MESSAGE
      // Purpose: Request shutdown of user's Audio Connector to prevent resource leaks
      // Server processing: Handled in "close_audio_connector" section of WebSocket message handler
      var msg = {
        command: "close_audio_connector",
        sessionid: "<%=sessionId%>",
        userid: userId, // Using connectionId for proper cleanup
      };

      // Update UI and state immediately
      button.text("Start Deepgram");
      button.css("background-color", "darkslategrey");
      setDeepgramInUse(false);

      // OPTIONAL: Re-subscribe to other users' Audio Connectors when stopping own translation
      // This allows user to receive others' translations again
      setTimeout(() => {
        if (window.currentSession) {
          console.log(
            "🔄 RESUBSCRIBE: Checking for other users' Audio Connectors to subscribe to..."
          );
          // Note: New Audio Connector streams will be automatically handled by streamCreated event
          // This is mainly for existing streams that we might have missed
        }
      }, 100);

      // Send shutdown request to server
      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify(msg));
      }

      console.log(
        "Stopping per-user Audio Connector for connectionId:",
        userId
      );
    }
  }

  /**
   * ENHANCED TRANSCRIPTION DISPLAY HANDLER
   * Receives and displays real-time transcription/translation results from the multi-user server
   *
   * Message Flow: Per-User Audio Connector → STT → Translation → TTS → This Handler
   *
   * Expected message formats from server:
   * 1. Legacy format: { sessionid: "session123", messages: { "0": "text" } }
   * 2. New multi-user format: {
   *      type: "transcription",
   *      speakerUserId: "connectionId_abc123",
   *      translatedText: "Hello world",
   *      sourceLanguage: "es",
   *      targetLanguage: "en"
   *    }
   * 3. User language changes: {
   *      type: "user_language_changed",
   *      userId: "connectionId_abc123",
   *      language: "es"
   *    }
   */
  function handleWebSocketMessage(evt) {
    // Parse the JSON message containing transcription results
    try {
      data = JSON.parse(evt.data);
      console.log("Received message:", data);

      // Handle different message types
      if (data.type === "transcription") {
        // NEW: Multi-user transcription format with connectionId
        const speakerName =
          data.speakerUserId === userId
            ? "You"
            : `Connection ${data.speakerUserId}`;
        const timestamp = data.timestamp || new Date().toLocaleTimeString();

        // Display formatted message with language info
        $("#deepgram").html(
          $("#deepgram").html() +
            "<div><strong>" +
            speakerName +
            "</strong> (" +
            data.sourceLanguage +
            "→" +
            data.targetLanguage +
            ") -> " +
            timestamp +
            " : " +
            data.translatedText +
            "</div>"
        );
      } else if (data.type === "user_language_changed") {
        // Handle language preference changes from other users
        if (data.userId !== userId) {
          $("#deepgram").html(
            $("#deepgram").html() +
              "<div><em>Connection " +
              data.userId +
              " changed language to " +
              data.language +
              "</em></div>"
          );
        }
      } else if (data.sessionid == "<%=sessionId%>") {
        // LEGACY: Handle old message format for backward compatibility
        // Only process messages for the current session (security check)
        for (const [key, value] of Object.entries(data.messages || {})) {
          console.log("Legacy message:", key, value);

          // Append formatted message to transcription display
          $("#deepgram").html(
            $("#deepgram").html() +
              "<div>Speaker " +
              key +
              " -> " +
              new Date().toLocaleTimeString() +
              " : " +
              value +
              "</div>"
          );
        }
      }

      // Auto-scroll transcription panel to show newest messages
      $("#transcription").animate(
        { scrollTop: $("#transcription").prop("scrollHeight") },
        100
      );
    } catch (error) {
      console.error("Error parsing WebSocket message:", error);
    }
  }

  // ENHANCED SET PREFERRED LANGUAGE BUTTON HANDLER
  document.getElementById("set_language_btn").onclick = function () {
    const lang = document.getElementById("preferred_language").value;

    if (!userId) {
      alert("Please wait for video session to connect first");
      return;
    }

    if (ws && ws.readyState === WebSocket.OPEN) {
      // Send enhanced language preference with connectionId as userId
      ws.send(
        JSON.stringify({
          command: "set_preferred_language",
          sessionid: "<%=sessionId%>",
          userid: userId, // Using connectionId for multi-user tracking
          language: lang,
        })
      );
      localStorage.setItem("preferred_language", lang);

      // Show confirmation in UI
      $("#deepgram").html(
        $("#deepgram").html() +
          "<div><strong>Your language preference set to: " +
          lang +
          "</strong></div>"
      );

      // Auto-scroll to show the update
      $("#transcription").animate(
        { scrollTop: $("#transcription").prop("scrollHeight") },
        100
      );

      console.log(
        "Language preference set:",
        lang,
        "for connectionId:",
        userId
      );
    } else {
      alert("WebSocket not connected. Please refresh the page.");
    }
  };

  // Auto-select last used language on page load
  document.addEventListener("DOMContentLoaded", function () {
    const savedLang = localStorage.getItem("preferred_language");
    if (savedLang) {
      const select = document.getElementById("preferred_language");
      if (select) select.value = savedLang;
    }
  });

  // Enhanced cleanup on page unload for multi-user architecture
  // If user closes tab/browser (without clicking Stop), ensure Audio Connector is cleaned up
  window.addEventListener("beforeunload", function (e) {
    if (deepgram_in_use && ws && ws.readyState === WebSocket.OPEN && userId) {
      // Send cleanup message for this specific connectionId
      var msg = {
        command: "close_audio_connector",
        sessionid: "<%=sessionId%>",
        userid: userId,
      };
      ws.send(JSON.stringify(msg));
      console.log("Cleanup sent for connectionId:", userId);
    }
  });
</script>
